// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = LinearCalendarMobile
PRODUCT_DISPLAY_NAME = Linear Calendar
PRODUCT_BUNDLE_IDENTIFIER = com.linearcalendar.mobile
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 18.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

// ==========================================
// Calendar Permissions
// ==========================================
INFOPLIST_KEY_NSCalendarsUsageDescription = Linear Calendar needs access to your calendar to display and sync your events.
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription = Linear Calendar needs full calendar access to read and display all your events.
INFOPLIST_KEY_NSRemindersUsageDescription = Linear Calendar may access reminders associated with your calendar events.
INFOPLIST_KEY_NSContactsUsageDescription = Linear Calendar may access contacts for event attendee information.

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/LinearCalendarMobile.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/LinearCalendarMobile.entitlements
